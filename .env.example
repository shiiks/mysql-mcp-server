# --- Transport -------------------------------------------------------------
# stdio:           local subprocess mode, no auth (default)
# streamable-http: hosted web service, requires OIDC_* below
MCP_TRANSPORT=stdio

# --- HTTP mode (only required when MCP_TRANSPORT=streamable-http) ----------
MCP_BIND_HOST=0.0.0.0
MCP_BIND_PORT=8000
MCP_PUBLIC_URL=https://mysql-mcp.example.com

# OIDC / IdP — used to verify bearer tokens forwarded by the MCP catalog.
# Works with any OIDC-compliant IdP (SSO, Okta, Auth0, Entra, Keycloak).
OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
OIDC_ISSUER=https://idp.example.com/
OIDC_AUDIENCE=mysql-mcp-server
OIDC_ALGORITHMS=RS256
# Space-separated; leave empty to allow any authenticated user.
OIDC_REQUIRED_SCOPES=

# --- MySQL connection ------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mcp_readonly
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CHARSET=utf8mb4
MYSQL_AUTOCOMMIT=true

# --- TLS / SSL -------------------------------------------------------------
# Most managed DBs (RDS, Aurora, Azure, etc.) require SSL. Defaults below
# enable TLS without certificate verification — same behavior as the
# pymysql ssl:{ssl:{}} idiom. Set MYSQL_SSL_CA + MYSQL_SSL_VERIFY_CERT=true
# in production once you have the CA bundle on the host.
MYSQL_SSL_DISABLED=false
MYSQL_SSL_VERIFY_CERT=false
MYSQL_SSL_VERIFY_IDENTITY=false
# Optional paths — set if you have certs to use:
# MYSQL_SSL_CA=/path/to/ca.pem
# MYSQL_SSL_CERT=/path/to/client-cert.pem
# MYSQL_SSL_KEY=/path/to/client-key.pem

# --- Safety flags ---------------------------------------------------------
MYSQL_ALLOW_WRITE=false
MYSQL_ALLOW_DDL=false
MYSQL_MAX_ROWS=1000
MYSQL_POOL_SIZE=5
